---
/**
 * La línea del sol: hora de La Habana, altura del sol sobre el horizonte y
 * cuánta luz queda. Se calcula en el navegador de quien mira, pero siempre
 * sobre La Habana — es mi cielo, no el suyo.
 *
 * Nace oculta y la enseña el script: sin JavaScript no hay dato que enseñar,
 * y una línea vacía se lee como un fallo.
 */
import { getLocale, t, type Locale } from '../../i18n/ui';

const locale: Locale = getLocale(Astro.url);
const ui = t(locale);
const textos = JSON.stringify({ ...ui.sol, locale });
---

<p
	id="linea-solar"
	data-textos={textos}
	title={ui.sol.titulo}
	hidden
	class="flex items-center gap-2.5 border-b border-border py-4 font-mono text-[11px] text-faint sm:text-xs"
>
	<svg
		id="linea-solar-arco"
		viewBox="0 0 46 16"
		class="h-4 w-[46px] shrink-0 overflow-visible"
		aria-hidden="true"
	>
		<path
			d="M3 11 Q 23 -1 43 11"
			fill="none"
			stroke="currentColor"
			stroke-width="0.6"
			stroke-dasharray="1.5 1.5"
			opacity="0.35"></path>
		<line x1="0" y1="11" x2="46" y2="11" stroke="currentColor" stroke-width="0.6" opacity="0.5"
		></line>
		<circle id="linea-solar-astro" cx="3" cy="11" r="2.4" fill="currentColor"></circle>
	</svg>
	<span id="linea-solar-texto"></span>
</p>

<script>
	import { altitudSolar, proximoCruce, horaEnHabana } from '../../lib/sol';

	const linea = document.getElementById('linea-solar');
	const texto = document.getElementById('linea-solar-texto');
	const astro = document.getElementById('linea-solar-astro');

	if (linea && texto && astro) {
		const textos = JSON.parse(linea.dataset.textos ?? '{}');
		const locale: 'es' | 'en' = textos.locale === 'en' ? 'en' : 'es';

		/** «3 h 10 min», «48 min». */
		const duracion = (ms: number) => {
			const minutos = Math.max(0, Math.round(ms / 60000));
			const h = Math.floor(minutos / 60);
			const m = minutos % 60;
			return h ? `${h} h ${String(m).padStart(2, '0')} min` : `${m} min`;
		};

		const pintar = () => {
			const ahora = new Date();
			const altitud = altitudSolar(ahora);
			const deDia = altitud > -0.833;

			const siguiente = proximoCruce(ahora);
			const anterior = proximoCruce(ahora, undefined, undefined, true);

			const posicion = (deDia ? textos.sobre : textos.bajo).replace(
				'{grados}',
				String(Math.abs(Math.round(altitud)))
			);

			const partes = [`${horaEnHabana(ahora, locale)} ${textos.enHabana}`, posicion];

			if (siguiente) {
				const restante = duracion(siguiente.fecha.getTime() - ahora.getTime());
				partes.push((deDia ? textos.luz : textos.amanecer).replace('{tiempo}', restante));
			}

			texto.textContent = partes.join(' · ');

			// El punto recorre el arco entre los dos cruces del horizonte.
			if (siguiente && anterior) {
				const tramo = siguiente.fecha.getTime() - anterior.fecha.getTime();
				const avance = Math.min(1, Math.max(0, (ahora.getTime() - anterior.fecha.getTime()) / tramo));
				const x = 3 + avance * 40;
				const alto = Math.min(1, Math.abs(altitud) / 75);
				const y = deDia ? 11 - alto * 9.5 : 11 + alto * 3.5;
				astro.setAttribute('cx', x.toFixed(2));
				astro.setAttribute('cy', y.toFixed(2));
				astro.setAttribute('r', deDia ? '2.4' : '1.6');
				// De día el sol se pinta con el violeta de la marca; de noche se apaga.
				astro.style.fill = deDia ? 'var(--accent)' : 'currentColor';
				astro.style.opacity = deDia ? '1' : '0.55';
			}

			linea.hidden = false;
		};

		pintar();
		setInterval(pintar, 60000);
		// Al volver a la pestaña, el dato no puede estar media hora viejo.
		document.addEventListener('visibilitychange', () => {
			if (!document.hidden) pintar();
		});
	}
</script>
