---
interface Props {
	title: string;
	subtitle?: string;
}
const { title, subtitle } = Astro.props;
---

<div class="max-w-2xl" data-reveal>
	<h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
	{subtitle && <p class="mt-3 text-base leading-relaxed text-muted">{subtitle}</p>}
</div>
