---
interface Props {
	eyebrow: string;
	title: string;
	subtitle?: string;
}
const { eyebrow, title, subtitle } = Astro.props;
---

<div class="max-w-2xl">
	<p class="flex items-center gap-2 font-mono text-xs uppercase tracking-[0.18em] text-accent">
		<span class="h-px w-6 bg-accent" aria-hidden="true"></span>
		{eyebrow}
	</p>
	<h2 class="mt-4 text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h2>
	{subtitle && <p class="mt-4 text-base leading-relaxed text-muted">{subtitle}</p>}
</div>
