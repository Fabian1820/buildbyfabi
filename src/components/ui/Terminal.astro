---
import type { TerminalStep } from '../../i18n/ui';

type Step = TerminalStep & { links?: { label: string; href: string }[] };

interface Props {
	user: string;
	host: string;
	steps: Step[];
	/** Menos alto reservado, para terminales de pocas líneas. */
	dense?: boolean;
}

const { user, host, steps, dense = false } = Astro.props;

const toneClass = (tone?: string) =>
	tone === 'accent' ? 'text-accent-ink' : tone === 'muted' ? 'text-faint' : 'text-muted';
---

<div
	class="w-full overflow-hidden rounded-xl border border-border bg-card"
>
	<div class="flex items-center gap-3 border-b border-border px-4 py-2.5">
		<span class="font-mono text-xs text-faint">{user}@{host}: ~</span>
		<span class="ml-auto font-mono text-xs text-faint" aria-hidden="true">zsh</span>
	</div>

	<div
		data-term
		class:list={[
			'px-4 py-4 font-mono text-[13px] leading-relaxed',
			dense ? 'min-h-[170px]' : 'min-h-[200px] sm:min-h-[216px]',
		]}
	>
		{
			steps.map((step, i) => (
				<>
					<p class="term-line flex flex-wrap items-baseline gap-x-2" data-kind="cmd">
						<span class="shrink-0 select-none text-faint">
							<span class="text-accent-ink">$</span>
						</span>
						<span class="term-txt text-text" data-text={step.cmd}>{step.cmd}</span>
					</p>
					{step.links ? (
						<p class="term-line flex flex-wrap gap-x-4 gap-y-1" data-kind="out">
							{step.links.map((l) => (
								<a
									href={l.href}
									class="text-text underline decoration-border-strong underline-offset-4 transition-colors duration-150 hover:text-accent-ink hover:decoration-accent-ink"
								>
									{l.label}
								</a>
							))}
						</p>
					) : (
						<p class:list={['term-line', toneClass(step.tone)]} data-kind="out">
							{step.out}
						</p>
					)}
					{i < steps.length - 1 && <div class="term-line h-3" data-kind="blank" />}
				</>
			))
		}
		<p class="term-line term-final flex flex-wrap items-baseline gap-x-2" data-kind="final">
			<span class="shrink-0 select-none text-accent-ink">$</span>
			<span class="term-caret inline-block h-[1em] w-[7px] translate-y-[2px] bg-accent-ink animate-blink" aria-hidden="true"></span>
		</p>
	</div>
</div>

<script>
	const TYPE = 20;
	const AFTER_CMD = 190;
	const AFTER_OUT = 110;
	const START = 400;

	document.querySelectorAll<HTMLElement>('[data-term]').forEach((term) => {
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const lines = Array.from(term.querySelectorAll<HTMLElement>('.term-line'));
		if (reduced || !lines.length || !('IntersectionObserver' in window)) return;

		// Punto de partida: todo oculto salvo el cursor final, que viaja con la escritura.
		lines.forEach((l) => (l.style.display = 'none'));
		term.querySelectorAll<HTMLElement>('.term-txt').forEach((s) => (s.textContent = ''));

		const caretLine = term.querySelector<HTMLElement>('.term-final');
		const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

		const run = async () => {
			await wait(START);
			for (const line of lines) {
				const kind = line.dataset.kind;
				if (kind === 'final') break;

				line.style.display = kind === 'blank' ? 'block' : 'flex';

				if (kind === 'cmd') {
					const span = line.querySelector<HTMLElement>('.term-txt');
					const text = span?.dataset.text ?? '';
					span?.classList.add('typing');
					for (let i = 1; i <= text.length; i++) {
						if (span) span.textContent = text.slice(0, i);
						await wait(TYPE);
					}
					await wait(AFTER_CMD);
					span?.classList.remove('typing');
				} else if (kind === 'out') {
					await wait(AFTER_OUT);
				}
			}
			if (caretLine) caretLine.style.display = 'flex';
		};

		// Empieza cuando se ve: en móvil el terminal queda bajo el pliegue y la
		// secuencia terminaba antes de que nadie llegara a verla.
		const io = new IntersectionObserver(
			(entradas) => {
				if (!entradas.some((e) => e.isIntersecting)) return;
				io.disconnect();
				run();
			},
			{ threshold: 0.5 }
		);
		io.observe(term);
	});
</script>
