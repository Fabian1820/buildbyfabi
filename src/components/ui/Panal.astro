---
/**
 * El panal: un mapa autoorganizado que coloca mis proyectos solo.
 *
 * Cada celda es una neurona con un vector de seis áreas; al cargar, el mapa se
 * entrena con los proyectos de esta misma página y cada celda acaba siendo de
 * quien más se le parece. Nadie decide dónde va cada uno — por eso los que
 * comparten stack acaban vecinos.
 */
import { PROJECTS } from '../../data/site';
import { getLocale, t, type Locale } from '../../i18n/ui';
import { vectorDeStack, areasDe } from '../../lib/areas';

const locale: Locale = getLocale(Astro.url);
const ui = t(locale);

const muestras = PROJECTS.map((proyecto) => {
	const vector = vectorDeStack(proyecto.stack);
	return {
		slug: proyecto.slug,
		titulo: proyecto.title[locale],
		vector,
		areas: areasDe(vector, locale).join(' · '),
	};
});
---

<figure class="mt-12" data-reveal>
	<div class="relative overflow-hidden rounded-2xl border border-border bg-card">
		<canvas
			id="panal"
			data-muestras={JSON.stringify(muestras)}
			class="block h-[150px] w-full cursor-crosshair sm:h-[210px]"
			role="img"
			aria-label={ui.panal.alt}></canvas>
	</div>

	<figcaption
		id="panal-pie"
		aria-live="polite"
		data-pista={ui.panal.pista}
		data-pista-tactil={ui.panal.pistaTactil}
		class="mt-3 font-mono text-[11px] leading-relaxed text-faint sm:text-xs"
	>
		{ui.panal.pista}
	</figcaption>
</figure>

<script>
	import { MapaAutoorganizado } from '../../lib/som';

	type Muestra = { slug: string; titulo: string; vector: number[]; areas: string };

	const lienzo = document.getElementById('panal') as HTMLCanvasElement | null;
	const pie = document.getElementById('panal-pie');

	if (lienzo && pie) {
		const muestras: Muestra[] = JSON.parse(lienzo.dataset.muestras ?? '[]');
		const vectores = muestras.map((m) => m.vector);
		// Sin cursor que pasar por encima, la pista tiene que hablar de tocar.
		const sinCursor = window.matchMedia('(hover: none)').matches;
		const pista = (sinCursor ? pie.dataset.pistaTactil : pie.dataset.pista) ?? '';
		pie.textContent = pista;
		const quietud = window.matchMedia('(prefers-reduced-motion: reduce)');
		const ctx = lienzo.getContext('2d')!;

		let mapa!: MapaAutoorganizado;
		let radio = 12;
		let duenno: number[] = [];
		let cercania: number[] = [];
		let resaltado = -1;
		let animacion = 0;

		const centro = (indice: number) => {
			const { columna, fila } = mapa.celda(indice);
			const ancho = Math.sqrt(3) * radio;
			return {
				x: ancho * (columna + (fila & 1 ? 0.5 : 0)) + ancho / 2,
				y: 1.5 * radio * fila + radio,
			};
		};

		const color = (nombre: string) =>
			getComputedStyle(document.documentElement).getPropertyValue(nombre).trim();

		/** El violeta de la marca, en HSL, para poder girarle el tono. */
		const tonoAcento = () => {
			const hex = color('--accent').replace('#', '');
			const [r, g, b] = [0, 2, 4].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255);
			const max = Math.max(r, g, b);
			const min = Math.min(r, g, b);
			const l = (max + min) / 2;
			if (max === min) return { h: 262, s: 60, l: l * 100 };
			const d = max - min;
			const s = d / (1 - Math.abs(2 * l - 1));
			const h =
				max === r
					? ((g - b) / d + (g < b ? 6 : 0)) * 60
					: max === g
						? ((b - r) / d + 2) * 60
						: ((r - g) / d + 4) * 60;
			return { h, s: s * 100, l: l * 100 };
		};

		/**
		 * Un tono por proyecto, girando alrededor del violeta de la marca: se
		 * distinguen las regiones sin salirse de la familia de color del sitio.
		 */
		const paleta = () => {
			const { h, s } = tonoAcento();
			const oscuro = document.documentElement.classList.contains('dark');
			const n = muestras.length;

			// Los tonos no se reparten por orden de la lista sino por dónde acabó
			// cada proyecto en el mapa, y saltando: así dos regiones vecinas nunca
			// se llevan tonos parecidos y el panal se lee de un vistazo.
			const porPosicion = muestras
				.map((m, i) => ({ i, x: centro(mapa.mejorNeurona(m.vector)).x }))
				.sort((a, b) => a.x - b.x);

			const salto = Math.ceil(n / 2);
			const tonos = muestras.map(() => ({ h, s: 50, l: 60 }));

			porPosicion.forEach(({ i }, posicion) => {
				const paso = (posicion * salto) % n;
				tonos[i] = {
					h: h - 55 + (110 / (n - 1)) * paso,
					s: Math.min(58, Math.max(42, s)),
					l: oscuro ? 62 : 60,
				};
			});

			return tonos;
		};

		/** Cada neurona se queda con el proyecto que más se le parece. */
		const repartir = () => {
			duenno = [];
			cercania = [];
			let peor = 0;

			for (const pesos of mapa.pesos) {
				let mejor = 0;
				let minima = Infinity;
				for (let m = 0; m < vectores.length; m++) {
					let suma = 0;
					for (let d = 0; d < pesos.length; d++) {
						const dif = pesos[d] - vectores[m][d];
						suma += dif * dif;
					}
					if (suma < minima) {
						minima = suma;
						mejor = m;
					}
				}
				duenno.push(mejor);
				cercania.push(minima);
				peor = Math.max(peor, minima);
			}

			// La distancia se normaliza para pintar: cerca opaco, lejos translúcido.
			cercania = cercania.map((d) => (peor > 0 ? 1 - d / peor : 1));

			// Voto mayoritario entre vecinas, como al etiquetar en Panal SOM: quita
			// las celdas sueltas que caen dentro de la región de otro proyecto.
			const suavizado = duenno.map((mio, i) => {
				const votos = new Map<number, number>([[mio, 1.5]]);
				for (const v of vecinas(i)) votos.set(duenno[v], (votos.get(duenno[v]) ?? 0) + 1);
				return [...votos.entries()].sort((a, b) => b[1] - a[1])[0][0];
			});
			duenno = suavizado;
		};

		const hexagono = (x: number, y: number, r: number) => {
			ctx.beginPath();
			for (let i = 0; i < 6; i++) {
				const angulo = ((60 * i - 30) * Math.PI) / 180;
				const px = x + r * Math.cos(angulo);
				const py = y + r * Math.sin(angulo);
				i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
			}
			ctx.closePath();
		};

		const pintar = () => {
			const tonos = paleta();
			const fondo = color('--card');
			const texto = color('--text');

			ctx.clearRect(0, 0, lienzo.width, lienzo.height);

			for (let i = 0; i < mapa.pesos.length; i++) {
				const { x, y } = centro(i);
				const mio = duenno[i];
				const suyo = resaltado === -1 || resaltado === mio;
				const { h, s, l } = tonos[mio];

				// La distancia a su proyecto aclara la celda: el borde de cada
				// región se ve más pálido, como en una U-matrix.
				const claridad = l + (1 - cercania[i]) * 15;
				hexagono(x, y, radio * 0.9);
				ctx.fillStyle = `hsl(${h} ${s}% ${claridad}%)`;
				ctx.globalAlpha = suyo ? 0.92 : 0.16;
				ctx.fill();

				// Frontera: se abre un hueco del color del fondo entre regiones.
				const frontera = vecinas(i).some((v) => duenno[v] !== mio);
				if (frontera) {
					ctx.globalAlpha = suyo ? 1 : 0.25;
					ctx.strokeStyle = fondo;
					ctx.lineWidth = 2.5;
					ctx.stroke();
				}
			}

			ctx.globalAlpha = 1;

			// El nombre de cada proyecto, en el centro de su región.
			if (lienzo.clientWidth >= 640) {
				ctx.font = '600 11px ui-monospace, SFMono-Regular, Menlo, monospace';
				ctx.textAlign = 'center';
				ctx.textBaseline = 'middle';

				muestras.forEach((muestra, m) => {
					const celdas = duenno.reduce<number[]>((acc, d, i) => (d === m ? [...acc, i] : acc), []);
					if (celdas.length < 6) return;
					const puntos = celdas.map(centro);
					const x = puntos.reduce((s, p) => s + p.x, 0) / puntos.length;
					const y = puntos.reduce((s, p) => s + p.y, 0) / puntos.length;

					ctx.globalAlpha = resaltado === -1 || resaltado === m ? 1 : 0.3;
					ctx.lineWidth = 3.5;
					ctx.strokeStyle = fondo;
					ctx.strokeText(muestra.titulo, x, y);
					ctx.fillStyle = texto;
					ctx.fillText(muestra.titulo, x, y);
				});

				ctx.globalAlpha = 1;
			}
		};

		/** Las seis vecinas de una celda «odd-r», sin salirse de la rejilla. */
		const vecinas = (indice: number) => {
			const { columna, fila } = mapa.celda(indice);
			const impar = fila & 1;
			const saltos = [
				[+1, 0],
				[-1, 0],
				[impar ? +1 : -1, -1],
				[0, -1],
				[impar ? +1 : -1, +1],
				[0, +1],
			];
			const salida: number[] = [];
			for (const [dc, df] of saltos) {
				const c = columna + dc;
				const f = fila + df;
				if (c < 0 || f < 0 || c >= mapa.columnas || f >= mapa.filas) continue;
				salida.push(f * mapa.columnas + c);
			}
			return salida;
		};

		const montar = () => {
			cancelAnimationFrame(animacion);

			const dpr = Math.min(2, window.devicePixelRatio || 1);
			const ancho = lienzo.clientWidth;
			const alto = lienzo.clientHeight;
			lienzo.width = ancho * dpr;
			lienzo.height = alto * dpr;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			// Pocas celdas y grandes: el mapa se lee como un panal, no como textura.
			const filas = alto < 180 ? 4 : 5;
			radio = alto / (1.5 * (filas - 1) + 2);
			const columnas = Math.max(6, Math.floor(ancho / (Math.sqrt(3) * radio)));

			mapa = new MapaAutoorganizado({
				columnas,
				filas,
				dimension: vectores[0]?.length ?? 6,
				epocas: 90,
			});

			if (quietud.matches) {
				while (!mapa.terminado) mapa.paso(vectores);
				repartir();
				pintar();
				return;
			}

			const cuadro = () => {
				mapa.paso(vectores);
				repartir();
				pintar();
				if (!mapa.terminado) animacion = requestAnimationFrame(cuadro);
			};
			animacion = requestAnimationFrame(cuadro);
		};

		const celdaEn = (evento: PointerEvent | MouseEvent) => {
			if (!mapa) return -1;
			const caja = lienzo.getBoundingClientRect();
			const x = evento.clientX - caja.left;
			const y = evento.clientY - caja.top;
			let mejor = -1;
			let minima = Infinity;
			for (let i = 0; i < mapa.pesos.length; i++) {
				const p = centro(i);
				const d = (p.x - x) ** 2 + (p.y - y) ** 2;
				if (d < minima) {
					minima = d;
					mejor = i;
				}
			}
			return minima <= (radio * 1.2) ** 2 ? mejor : -1;
		};

		const resaltar = (indice: number) => {
			if (!mapa || indice === resaltado) return;
			resaltado = indice;
			if (indice === -1) {
				pie.textContent = pista;
			} else {
				const muestra = muestras[indice];
				pie.textContent = `${muestra.titulo} — ${muestra.areas}`;
			}
			pintar();
		};

		lienzo.addEventListener('pointermove', (e) => {
			const celda = celdaEn(e);
			resaltar(celda === -1 ? -1 : duenno[celda]);
		});
		lienzo.addEventListener('pointerleave', () => resaltar(-1));

		lienzo.addEventListener('click', (e) => {
			const celda = celdaEn(e);
			if (celda === -1) return;
			// En una pantalla táctil el toque es la única forma de saber de quién
			// es la celda: primero se dice, después se salta.
			resaltar(duenno[celda]);
			const tarjeta = document.getElementById(`proyecto-${muestras[duenno[celda]].slug}`);
			if (!tarjeta) return;
			// Si la tarjeta está plegada tras «ver más», primero se despliega.
			const oculto = tarjeta.closest<HTMLElement>('[hidden]');
			if (oculto) document.getElementById('ver-mas')?.click();
			tarjeta.scrollIntoView({ block: 'center', behavior: 'smooth' });
			tarjeta.classList.add('recien-senalada');
			setTimeout(() => tarjeta.classList.remove('recien-senalada'), 1600);
		});

		// Al pasar por una tarjeta se enciende su región: el mapa y la rejilla
		// hablan del mismo trabajo.
		muestras.forEach((muestra, m) => {
			const tarjeta = document.getElementById(`proyecto-${muestra.slug}`);
			tarjeta?.addEventListener('pointerenter', () => resaltar(m));
			tarjeta?.addEventListener('pointerleave', () => resaltar(-1));
		});

		// El mapa se entrena cuando el panal entra en pantalla: quien llega hasta
		// aquí ve cómo se ordena, en vez de encontrárselo ya hecho.
		if ('IntersectionObserver' in window) {
			const vigia = new IntersectionObserver(
				(entradas) => {
					if (!entradas.some((e) => e.isIntersecting)) return;
					vigia.disconnect();
					montar();
				},
				{ threshold: 0.25 }
			);
			vigia.observe(lienzo);
		} else {
			montar();
		}

		let temporizador: number;
		window.addEventListener('resize', () => {
			clearTimeout(temporizador);
			temporizador = window.setTimeout(montar, 200);
		});

		// El violeta no es el mismo en claro que en oscuro: hay que repintar.
		new MutationObserver(() => mapa && pintar()).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['class'],
		});
	}
</script>

<style>
	:global(.recien-senalada) {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
		transition: outline-color 0.4s ease;
	}
</style>
