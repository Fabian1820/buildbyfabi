---
import { Image } from 'astro:assets';
import { getLocale, t, type Locale } from '../../i18n/ui';
import type { Project } from '../../data/site';

interface Props {
	project: Project;
	size?: 'sm' | 'lg';
	/** Posición dentro de su rejilla: escalona la entrada al hacer scroll. */
	index?: number;
}

const { project, size = 'sm', index = 0 } = Astro.props;
const locale: Locale = getLocale(Astro.url);
const ui = t(locale);
const lg = size === 'lg';

const statusTone: Record<string, string> = {
	live: 'text-ok border-ok/30 bg-ok/10',
	wip: 'text-warn border-warn/30 bg-warn/10',
	oss: 'text-accent-ink border-accent-ink/30 bg-accent-ink/10',
	private: 'text-faint border-border bg-bg-subtle',
	archived: 'text-faint border-border bg-bg-subtle',
};
---

<article
	id={`proyecto-${project.slug}`}
	data-reveal
	style={`--reveal-i:${index}`}
	class:list={[
		'group relative flex scroll-mt-24 flex-col overflow-hidden rounded-2xl border border-border bg-card transition-colors duration-200 hover:border-border-strong',
		lg ? 'p-7 sm:p-8' : 'p-6',
	]}
>
	<div class="relative flex flex-1 flex-col">
		<div
			class:list={[
				'overflow-hidden border-b border-border',
				lg ? '-mx-7 -mt-7 mb-7 sm:-mx-8 sm:-mt-8 sm:mb-8' : '-mx-6 -mt-6 mb-6',
			]}
		>
			{
				project.image ? (
					<Image
						src={project.image}
						alt={`${ui.work.previewAlt} ${project.title[locale]}`}
						widths={[420, 840, 1260]}
						sizes={lg ? '(min-width: 1024px) 34vw, 92vw' : '(min-width: 1024px) 23vw, (min-width: 640px) 45vw, 92vw'}
						format="webp"
						quality={72}
						class="aspect-[16/10] w-full object-cover object-top transition-[filter] duration-300 ease-out dark:brightness-[.82] dark:group-hover:brightness-100"
					/>
				) : (
					// Sin captura pública: se dice por qué, en vez de dejar el hueco.
					<div class="flex aspect-[16/10] items-center justify-center bg-bg-subtle bg-[radial-gradient(var(--color-border)_1px,transparent_1px)] [background-size:14px_14px]">
						<span class="rounded-full border border-border bg-card px-3 py-1 text-xs text-faint">
							{ui.work.noPreview}
						</span>
					</div>
				)
			}
		</div>

		<div class="flex items-start justify-between gap-3">
			<div class="flex items-center gap-2.5">
				{
					project.status && (
						<span
							class:list={[
								'rounded-full border px-2.5 py-0.5 text-xs font-medium',
								statusTone[project.status],
							]}
						>
							{ui.work.status[project.status]}
						</span>
					)
				}
			</div>
			<span class="shrink-0 text-xs tabular-nums text-faint">{project.year}</span>
		</div>

		<h3
			class:list={[
				'mt-4 font-semibold tracking-tight text-text',
				lg ? 'text-2xl' : 'text-lg',
			]}
		>
			{project.title[locale]}
		</h3>

		<p class="mt-1.5 text-sm font-medium text-muted">{project.tagline[locale]}</p>

		<p
			class:list={[
				'mt-4 flex-1 leading-relaxed text-muted',
				lg ? 'text-[15px]' : 'text-sm',
			]}
		>
			{project.description[locale]}
		</p>

		<ul class="mt-6 flex flex-wrap gap-1.5">
			{
				project.stack.map((s) => (
					<li class="rounded-md border border-border px-2 py-0.5 text-xs text-faint">
						{s}
					</li>
				))
			}
		</ul>

		{
			(project.links?.live || project.links?.repo || project.privateCode) && (
				<div class="mt-6 flex flex-wrap items-center gap-2 border-t border-border pt-5">
					{project.links?.live && (
						<a
							href={project.links.live}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex min-h-11 items-center gap-1.5 rounded-lg bg-accent-soft px-3 py-2 text-xs sm:min-h-9 font-medium text-accent-ink transition-[background-color,color,scale] duration-150 ease-out hover:bg-accent hover:text-on-accent motion-safe:active:scale-[0.97]"
						>
							<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
							</svg>
							{ui.work.viewLive}
						</a>
					)}
					{project.privateCode && (
						<span class="inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-dashed border-border px-3 py-2 text-xs sm:min-h-9 font-medium text-faint">
							<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<rect x="4" y="10" width="16" height="10" rx="2" />
								<path d="M8 10V7a4 4 0 0 1 8 0v3" />
							</svg>
							{ui.work.privateCode}
						</span>
					)}
					{project.links?.repo && (
						<a
							href={project.links.repo}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-border-strong px-3 py-2 text-xs sm:min-h-9 font-medium text-text transition-[border-color,color,scale] duration-150 ease-out hover:border-accent-ink hover:text-accent-ink motion-safe:active:scale-[0.97]"
						>
							<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.26 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z" />
							</svg>
							{ui.work.viewCode}
						</a>
					)}
				</div>
			)
		}
	</div>
</article>
