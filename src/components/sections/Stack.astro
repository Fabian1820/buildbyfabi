---
import { getLocale, t, type Locale } from '../../i18n/ui';
import { STACK } from '../../data/site';
import SectionHeading from '../ui/SectionHeading.astro';

const locale: Locale = getLocale(Astro.url);
const ui = t(locale);

const marquee = [
	'React', 'Next.js', 'TypeScript', 'Astro', 'Tailwind CSS', 'Svelte',
	'Python', 'FastAPI', 'MongoDB', 'Kotlin', 'Swift', 'Docker', 'Git',
];
---

<section id="stack" class="scroll-mt-24 border-t border-border bg-bg-subtle">
	<div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
		<SectionHeading eyebrow={ui.stack.eyebrow} title={ui.stack.title} subtitle={ui.stack.subtitle} />

		<div class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
			{
				STACK.map((group) => (
					<div class="bg-card p-6">
						<h3 class="font-mono text-[11px] uppercase tracking-[0.16em] text-accent">
							{group.label[locale]}
						</h3>
						<ul class="mt-4 flex flex-wrap gap-2">
							{group.items.map((item) => (
								<li class="rounded-lg border border-border px-2.5 py-1 text-[13px] text-muted transition-colors hover:border-accent hover:text-text">
									{item}
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>

	<!-- marquee -->
	<div class="relative overflow-hidden border-t border-border py-6 mask-fade-x">
		<div class="flex w-max animate-marquee gap-10 pr-10">
			{
				[0, 1].map(() => (
					<div class="flex shrink-0 items-center gap-10" aria-hidden="true">
						{marquee.map((m) => (
							<span class="font-mono text-sm text-faint">{m}</span>
						))}
					</div>
				))
			}
		</div>
	</div>
</section>
