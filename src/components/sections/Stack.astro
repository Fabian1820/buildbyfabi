---
import { getLocale, t, type Locale } from '../../i18n/ui';
import { PROJECTS } from '../../data/site';
import { STACK_CON_USOS } from '../../lib/usos';
import { iconoDe, estiloMarca } from '../../lib/marca';
import SectionHeading from '../ui/SectionHeading.astro';

const locale: Locale = getLocale(Astro.url);
const ui = t(locale);

const textos = {
	es: {
		pista: 'Pasa el cursor (o toca) un proyecto, una tecnología o una habilidad para ver sus conexiones.',
		proyecto: 'Proyecto',
		tecnologia: 'Tecnología',
		habilidad: 'Habilidad',
		habilidades: 'Habilidades',
		habilidadesNota: 'Las uso a diario, aunque no salgan en ninguna tarjeta.',
	},
	en: {
		pista: 'Hover (or tap) a project, a technology or a skill to see its connections.',
		proyecto: 'Project',
		tecnologia: 'Technology',
		habilidad: 'Skill',
		habilidades: 'Skills',
		habilidadesNota: "I use them daily, even if they aren't in any card.",
	},
}[locale];

const clave = (n: string) => n.toLowerCase().replace(/[\s.]/g, '');

// Tecnologías conectadas: las del stack con algún proyecto, más las que salen
// en las tarjetas sin estar en el stack declarado.
const declaradas = STACK_CON_USOS.flatMap((g) => g.items.filter((i) => i.proyectos.length).map((i) => i.name));
const extra = [...new Set(PROJECTS.flatMap((p) => p.stack))].filter(
	(n) => !STACK_CON_USOS.some((g) => g.items.some((i) => clave(i.name) === clave(n)))
);
const techs = [...declaradas, ...extra];

// Habilidades: lo del stack que no sale en ninguna tarjeta. Van aparte y sin
// conexiones, porque no se las atribuimos a ningún proyecto.
const habilidades = STACK_CON_USOS.flatMap((g) => g.items.filter((i) => !i.proyectos.length)).map((i) => ({
	nombre: i.name,
	icono: iconoDe(i.icon),
}));

const corto: Record<string, string> = { 'gemelo-digital': 'Gemelo digital', shellbox: 'ShellBox', 'panal-som': 'Panal SOM' };
const iniciales = (n: string) =>
	n
		.split(/\s+/)
		.slice(0, 2)
		.map((w) => w[0].toUpperCase())
		.join('');
const todos = PROJECTS.map((p) => {
	const nombre = corto[p.slug] ?? p.title[locale];
	return { slug: p.slug, nombre, logo: p.logo, sigla: iniciales(nombre), stack: p.stack.map(clave) };
});

// Orden de los proyectos: el que deja juntos a los que comparten tecnologías,
// para que se crucen menos líneas. Con 7 proyectos se prueban todas las
// permutaciones (5 040) al compilar; no cuesta nada en el navegador.
const comparten = (a: (typeof todos)[number], b: (typeof todos)[number]) => a.stack.filter((x) => b.stack.includes(x)).length;
function* permutaciones<T>(xs: T[]): Generator<T[]> {
	if (xs.length <= 1) return yield xs;
	for (let i = 0; i < xs.length; i++)
		for (const resto of permutaciones([...xs.slice(0, i), ...xs.slice(i + 1)])) yield [xs[i], ...resto];
}
const coste = (orden: typeof todos, circular: boolean) => {
	let c = 0;
	for (let i = 0; i < orden.length; i++)
		for (let j = i + 1; j < orden.length; j++) {
			let d = j - i;
			if (circular) d = Math.min(d, orden.length - d);
			c += comparten(orden[i], orden[j]) * d;
		}
	return c;
};
const mejorOrden = (circular: boolean) => {
	let mejor = todos, min = Infinity;
	// El primero se fija: las rotaciones dan el mismo dibujo.
	for (const resto of permutaciones(todos.slice(1))) {
		const o = [todos[0], ...resto];
		const c = coste(o, circular);
		if (c < min) [min, mejor] = [c, o];
	}
	return mejor;
};
const proyectos = mejorOrden(true);
const aristas = techs.flatMap((tName, ti) =>
	proyectos.flatMap((p, pi) => (p.stack.includes(clave(tName)) ? [{ ti, pi }] : []))
);

// Media de una lista de números; para ordenar cada tecnología cerca de sus proyectos.
const media = (xs: number[]) => xs.reduce((a, b) => a + b, 0) / Math.max(1, xs.length);

type P = { x: number; y: number };
type Plano = {
	w: number;
	h: number;
	/** Dónde acaba el grafo y empieza el estante de habilidades */
	hGrafo: number;
	r: number;
	/** Los proyectos llevan la etiqueta fuera del círculo o siempre debajo */
	etiqueta: 'radial' | 'debajo';
	cy: number;
	proy: P[];
	tech: (P & { ancla: 'start' | 'end' })[];
	skills: (P & { ancho: number })[];
	titulo: P;
	/** La nota del estante: a continuación del título o, si no cabe, debajo */
	nota: P;
};

const anchoTexto = (s: string) => Math.round(s.length * 7.4);

/** Escritorio: proyectos en una elipse interior, tecnologías en la exterior, habilidades en un estante. */
function planoAncho(): Plano {
	const w = 1000, hGrafo = 600, cx = w / 2, cy = hGrafo / 2;
	const angP = proyectos.map((_, i) => -Math.PI / 2 + (i / proyectos.length) * Math.PI * 2);
	const proy = angP.map((a) => ({ x: cx + 190 * Math.cos(a), y: cy + 120 * Math.sin(a) }));

	// Ángulo medio (circular) de los proyectos de cada tecnología, y reparto uniforme en ese orden.
	const deseado = techs.map((_, ti) => {
		const as = aristas.filter((e) => e.ti === ti).map((e) => angP[e.pi]);
		return Math.atan2(media(as.map(Math.sin)), media(as.map(Math.cos)));
	});
	const orden = techs.map((_, i) => i).sort((a, b) => deseado[a] - deseado[b]);
	const tech: Plano['tech'] = new Array(techs.length);
	orden.forEach((ti, k) => {
		const a = deseado[orden[0]] + (k / techs.length) * Math.PI * 2;
		const x = cx + 400 * Math.cos(a);
		tech[ti] = { x, y: cy + 250 * Math.sin(a), ancla: x >= cx ? 'start' : 'end' };
	});

	// Estante: una fila repartida por el ancho, con el hueco que sobre entre las piezas.
	const piezas = habilidades.map((h) => 30 + 10 + anchoTexto(h.nombre));
	const hueco = Math.max(18, (920 - piezas.reduce((a, b) => a + b, 0)) / Math.max(1, piezas.length - 1));
	let x = (w - (piezas.reduce((a, b) => a + b, 0) + hueco * (piezas.length - 1))) / 2;
	const skills = piezas.map((ancho) => {
		const s = { x: x + 15, y: hGrafo + 74, ancho };
		x += ancho + hueco;
		return s;
	});
	const titulo = { x: 40, y: hGrafo + 30 };
	const nota = { x: titulo.x + anchoTexto(textos.habilidades) + 14, y: titulo.y };
	return { w, h: hGrafo + 100, hGrafo, r: 26, etiqueta: 'radial', cy, proy, tech, skills, titulo, nota };
}

/** Móvil: proyectos en una columna central, tecnologías a los lados, habilidades en dos columnas debajo. */
function planoAlto(): Plano {
	const w = 400, paso = 30;
	const filas = Math.ceil(techs.length / 2);
	const hG = Math.max(filas * paso + 60, proyectos.length * 82 + 60);
	const proy = proyectos.map((_, i) => ({ x: w / 2, y: 50 + i * ((hG - 110) / (proyectos.length - 1)) }));
	const yMedia = techs.map((_, ti) => media(aristas.filter((e) => e.ti === ti).map((e) => proy[e.pi].y)));
	const orden = techs.map((_, i) => i).sort((a, b) => yMedia[a] - yMedia[b]);
	const tech: Plano['tech'] = new Array(techs.length);
	// Alterna izquierda y derecha siguiendo el orden vertical.
	const izq = orden.filter((_, k) => k % 2 === 0);
	const der = orden.filter((_, k) => k % 2 === 1);
	const colocar = (lista: number[], x: number, ancla: 'start' | 'end') =>
		lista.forEach((ti, k) => {
			tech[ti] = { x, y: 40 + k * ((hG - 90) / Math.max(1, lista.length - 1)), ancla };
		});
	colocar(izq, 96, 'end');
	colocar(der, 304, 'start');

	const base = hG + 86;
	const skills = habilidades.map((h, i) => ({
		x: 34 + (i % 2) * 180 + 15,
		y: base + Math.floor(i / 2) * 42,
		ancho: 30 + 10 + anchoTexto(h.nombre),
	}));
	const h = base + Math.ceil(habilidades.length / 2) * 42 + 6;
	const titulo = { x: 20, y: hG + 28 };
	return { w, h, hGrafo: hG, r: 23, etiqueta: 'debajo', cy: hG / 2, proy, tech, skills, titulo, nota: { x: titulo.x, y: titulo.y + 20 } };
}

const planos = [
	{ clase: 'hidden sm:block', p: planoAncho() },
	{ clase: 'sm:hidden', p: planoAlto() },
];

const curva = (a: P, b: P, c: P) => {
	// Curva hacia el centro: la constelación se lee como un tejido, no como radios.
	const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
	return `M${a.x.toFixed(1)},${a.y.toFixed(1)} Q${(mx + (c.x - mx) * 0.25).toFixed(1)},${(my + (c.y - my) * 0.25).toFixed(1)} ${b.x.toFixed(1)},${b.y.toFixed(1)}`;
};
---

<section id="stack" class="scroll-mt-24 border-t border-border">
	<div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
		<SectionHeading title={ui.stack.title} subtitle={ui.stack.subtitle} />
		<p class="mt-3 max-w-2xl text-sm text-faint">{textos.pista}</p>

		<ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-xs text-muted">
			<li class="flex items-center gap-2">
				<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="7.5" class="fill-white stroke-border-strong" stroke-width="1.5" /><circle cx="9" cy="9" r="2.5" class="fill-accent" /></svg>
				{textos.proyecto}
			</li>
			<li class="flex items-center gap-2">
				<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><circle cx="9" cy="9" r="3.5" class="fill-faint" /></svg>
				{textos.tecnologia}
			</li>
			<li class="flex items-center gap-2">
				<svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><rect x="2" y="2" width="14" height="14" rx="4.5" class="fill-bg-subtle stroke-border-strong" stroke-width="1.5" /></svg>
				{textos.habilidad}
			</li>
		</ul>

		<div data-reveal class="mt-6 overflow-hidden rounded-2xl border border-border bg-card p-2 sm:p-4">
			{
				planos.map(({ clase, p }) => (
					<svg
						class:list={['constelacion w-full', clase]}
						viewBox={`0 0 ${p.w} ${p.h}`}
						role="group"
						aria-label={ui.stack.title}
						data-constelacion
					>
						<g class="aristas" aria-hidden="true">
							{aristas.map((e) => (
								<path class="arista" pathLength="1" data-t={e.ti} data-p={e.pi} d={curva(p.tech[e.ti], p.proy[e.pi], { x: p.w / 2, y: p.cy })} />
							))}
						</g>

						<g>
							{techs.map((nombre, ti) => {
								const n = p.tech[ti];
								const dx = n.ancla === 'start' ? 9 : -9;
								return (
									<g class="nodo nodo-tech" data-t={ti} tabindex="0" role="button" aria-label={nombre}>
										<circle cx={n.x} cy={n.y} r="14" class="nodo-zona" />
										<circle cx={n.x} cy={n.y} r="3.5" class="nodo-punto" />
										<text x={n.x + dx} y={n.y} text-anchor={n.ancla} dominant-baseline="central">
											{nombre}
										</text>
									</g>
								);
							})}

							{proyectos.map((pr, pi) => {
								const n = p.proy[pi];
								const arriba = p.etiqueta === 'radial' && n.y < p.cy - 1;
								const ly = p.etiqueta === 'debajo' ? n.y + p.r + 16 : arriba ? n.y - p.r - 9 : n.y + p.r + 18;
								return (
									<a href={`#proyecto-${pr.slug}`} class="nodo nodo-proy" data-p={pi} aria-label={pr.nombre}>
										<circle cx={n.x} cy={n.y} r={p.r + 10} class="nodo-zona" />
										{pr.logo ? (
											<image href={pr.logo} x={n.x - p.r + 1} y={n.y - p.r + 1} width={2 * p.r - 2} height={2 * p.r - 2} />
										) : (
											<>
												<circle cx={n.x} cy={n.y} r={p.r - 1} class="mono-fondo" />
												<text x={n.x} y={n.y} text-anchor="middle" dominant-baseline="central" class="mono">
													{pr.sigla}
												</text>
											</>
										)}
										<circle cx={n.x} cy={n.y} r={p.r} class:list={['aro', !pr.logo && 'aro-sin-logo']} />
										<text x={n.x} y={ly} text-anchor="middle" class="etiqueta-proy">
											{pr.nombre}
										</text>
									</a>
								);
							})}
						</g>

						<!-- Estante de habilidades: aparte, sin conexiones -->
						<g class="estante">
							<line x1={p.titulo.x} x2={p.w - p.titulo.x} y1={p.hGrafo + 6} y2={p.hGrafo + 6} class="estante-linea" />
							<text x={p.titulo.x} y={p.titulo.y + 4} class="estante-titulo">{textos.habilidades}</text>
							<text x={p.nota.x} y={p.nota.y + 4} class="estante-nota">
								{textos.habilidadesNota}
							</text>
							{habilidades.map((h, si) => {
								const s = p.skills[si];
								return (
									<g class="nodo nodo-skill" data-s={si} tabindex="0" role="button" aria-label={`${textos.habilidad}: ${h.nombre}`} style={estiloMarca(h.icono)}>
										<rect x={s.x - 18} y={s.y - 19} width={s.ancho + 12} height="38" class="nodo-zona" />
										<rect x={s.x - 15} y={s.y - 15} width="30" height="30" rx="9" class="skill-chip" />
										{h.icono && (
											<svg x={s.x - 8} y={s.y - 8} width="16" height="16" viewBox="0 0 24 24">
												<path d={h.icono.path} class="skill-icono" />
											</svg>
										)}
										<text x={s.x + 25} y={s.y} dominant-baseline="central">
											{h.nombre}
										</text>
									</g>
								);
							})}
						</g>
					</svg>
				))
			}
		</div>
	</div>
</section>

<script>
	// Al activar un nodo se encienden sus aristas y sus vecinos; el resto se apaga.
	document.querySelectorAll<SVGSVGElement>('[data-constelacion]').forEach((svg) => {
		const aristas = Array.from(svg.querySelectorAll<SVGPathElement>('.arista'));
		const nodos = Array.from(svg.querySelectorAll<SVGElement>('.nodo'));

		const activar = (nodo: SVGElement | null) => {
			svg.toggleAttribute('data-activo', !!nodo);
			aristas.forEach((a) => a.classList.remove('on'));
			nodos.forEach((n) => n.classList.remove('on'));
			if (!nodo) return;
			nodo.classList.add('on');
			const t = nodo.dataset.t;
			const p = nodo.dataset.p;
			aristas.forEach((a) => {
				if ((t !== undefined && a.dataset.t === t) || (p !== undefined && a.dataset.p === p)) {
					a.classList.add('on');
					svg.querySelector(t !== undefined ? `.nodo-proy[data-p="${a.dataset.p}"]` : `.nodo-tech[data-t="${a.dataset.t}"]`)?.classList.add('on');
				}
			});
		};

		const fino = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
		nodos.forEach((n) => {
			// Sólo el foco de teclado: un toque también enfoca y estropearía el doble toque.
			n.addEventListener('focus', () => n.matches(':focus-visible') && activar(n));
			n.addEventListener('blur', () => activar(null));
			if (fino) {
				n.addEventListener('pointerenter', () => activar(n));
				n.addEventListener('pointerleave', () => activar(null));
			}
		});

		// En táctil: el primer toque en un proyecto enseña sus conexiones y el
		// segundo sigue el enlace a la tarjeta; en lo demás, un toque alterna.
		if (!fino) {
			svg.addEventListener('click', (e) => {
				const nodo = (e.target as Element).closest<SVGElement>('.nodo');
				if (!nodo) return activar(null);
				const encendido = nodo.classList.contains('on');
				if (nodo.classList.contains('nodo-proy')) {
					if (!encendido) {
						e.preventDefault();
						activar(nodo);
					}
					return;
				}
				activar(encendido ? null : nodo);
			});
		}
	});
</script>
