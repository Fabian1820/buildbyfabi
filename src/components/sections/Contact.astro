---
import { getLocale, t, type Locale } from '../../i18n/ui';
import { SITE } from '../../data/site';
import SectionHeading from '../ui/SectionHeading.astro';

const locale: Locale = getLocale(Astro.url);
const ui = t(locale);
---

<section id="contact" class="scroll-mt-24 border-t border-border bg-bg-subtle">
	<div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
		<SectionHeading title={ui.contact.title} subtitle={ui.contact.subtitle} />

		<div class="mt-10 grid gap-10 border-t border-border pt-10 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] lg:gap-16">
			<!-- Canal principal: el correo -->
			<div data-reveal class="min-w-0">
				<p class="text-sm text-faint">{ui.contact.emailLabel}</p>
				<a
					id="contact-email"
					href={`mailto:${SITE.email}`}
					class="mt-1 block truncate text-xl font-semibold tracking-tight text-text underline decoration-border-strong underline-offset-[6px] transition-colors duration-150 hover:decoration-accent-ink sm:text-3xl"
				>
					{SITE.email}
				</a>
				<p class="mt-3 text-sm text-muted">{ui.contact.emailHint}</p>
				<div class="mt-6 flex flex-wrap gap-2">
					<a
						href={`mailto:${SITE.email}`}
						class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-accent px-4 py-2.5 text-sm font-medium text-white transition-[filter,scale] duration-150 ease-out hover:brightness-110 motion-safe:active:scale-[0.97]"
					>
						<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect width="20" height="16" x="2" y="4" rx="2" />
							<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
						</svg>
						{ui.contact.emailLabel}
					</a>
					<button
						type="button"
						data-copy={SITE.email}
						data-ok={ui.contact.copied}
						data-fail={ui.contact.copyFailed}
						class="inline-flex min-h-11 items-center gap-2 rounded-xl border border-border-strong px-4 py-2.5 text-sm font-medium text-text transition-[border-color,scale] duration-150 ease-out hover:border-accent-ink motion-safe:active:scale-[0.97]"
					>
						<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect width="13" height="13" x="9" y="9" rx="2" />
							<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
						</svg>
						{ui.contact.copy}
					</button>
				</div>
			</div>

			<!-- Canal secundario -->
			<div data-reveal style="--reveal-i:1" class="min-w-0">
				<p class="text-sm text-faint">{ui.contact.whatsappLabel}</p>
				<a
					href={SITE.whatsapp}
					target="_blank"
					rel="noopener noreferrer"
					class="group mt-1 inline-flex items-center gap-2.5 text-xl font-semibold tabular-nums tracking-tight text-text underline decoration-border-strong underline-offset-[6px] transition-colors duration-150 hover:decoration-accent-ink sm:text-2xl"
				>
					<svg class="h-5 w-5 shrink-0 text-muted transition-colors duration-150 group-hover:text-text" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4-.1-.5l-.9-2.1c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1.1 2.8 1.2 3c.1.2 2.1 3.2 5 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4Z" />
						<path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2Z" />
					</svg>
					{SITE.whatsappDisplay}
				</a>
				<p class="mt-3 text-sm text-muted">{ui.contact.whatsappHint}</p>
			</div>
		</div>

		<p class="mt-10 text-sm text-muted">
			{SITE.location[locale]} · {ui.contact.timezone}
		</p>
	</div>
</section>

<div
	id="toast"
	role="status"
	aria-live="polite"
	class="pointer-events-none fixed bottom-6 left-1/2 z-[60] -translate-x-1/2 translate-y-2 rounded-xl bg-text px-4 py-2.5 text-sm text-bg opacity-0 shadow-[0_8px_16px_-8px_rgb(0_0_0/0.3)] transition-[opacity,translate] duration-150 ease-out data-[show]:translate-y-0 data-[show]:opacity-100 data-[show]:duration-200 motion-reduce:translate-y-0"
>
</div>

<script>
	const toast = document.getElementById('toast');
	const correo = document.getElementById('contact-email');
	let timer: number | undefined;

	const avisar = (texto: string) => {
		if (!toast) return;
		toast.textContent = texto;
		toast.dataset.show = '';
		clearTimeout(timer);
		timer = window.setTimeout(() => delete toast.dataset.show, 2200);
	};

	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
		btn.addEventListener('click', async () => {
			const value = btn.dataset.copy;
			if (!value) return;
			try {
				await navigator.clipboard.writeText(value);
				avisar(btn.dataset.ok ?? '');
			} catch {
				// Portapapeles bloqueado: se deja el correo seleccionado para copiarlo a mano.
				if (correo) {
					const rango = document.createRange();
					rango.selectNodeContents(correo);
					const sel = window.getSelection();
					sel?.removeAllRanges();
					sel?.addRange(rango);
				}
				avisar(btn.dataset.fail ?? '');
			}
		});
	});
</script>
