---
import { getLocale, t, type Locale } from '../../i18n/ui';
import { SITE } from '../../data/site';
import SectionHeading from '../ui/SectionHeading.astro';

const locale: Locale = getLocale(Astro.url);
const ui = t(locale);

const channels = [
	{
		label: ui.contact.emailLabel,
		value: SITE.email,
		href: `mailto:${SITE.email}`,
		copy: SITE.email,
		icon: 'mail',
	},
	{
		label: ui.contact.whatsappLabel,
		value: SITE.whatsappDisplay,
		href: SITE.whatsapp,
		icon: 'whatsapp',
	},
	{
		label: ui.contact.githubLabel,
		value: `@${SITE.githubUser}`,
		href: SITE.github,
		icon: 'github',
	},
	{
		label: ui.contact.instagramLabel,
		value: '@bian0311',
		href: SITE.instagram,
		icon: 'instagram',
	},
];
---

<section id="contact" class="scroll-mt-24 border-t border-border bg-bg-subtle">
	<div class="relative mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-28">
		<div
			class="pointer-events-none absolute left-1/2 top-0 h-64 w-[700px] -translate-x-1/2 rounded-full bg-accent/10 blur-[110px]"
			aria-hidden="true"
		>
		</div>

		<div class="relative">
			<SectionHeading
				eyebrow={ui.contact.eyebrow}
				title={ui.contact.title}
				subtitle={ui.contact.subtitle}
			/>

			<div class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-border bg-border sm:grid-cols-2">
				{
					channels.map((c) => (
						<div class="group relative flex items-center gap-4 bg-card px-5 py-5 transition-colors hover:bg-bg-subtle">
							<span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl border border-border text-accent">
								{c.icon === 'mail' && (
									<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<rect width="20" height="16" x="2" y="4" rx="2" />
										<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
									</svg>
								)}
								{c.icon === 'whatsapp' && (
									<svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4-.1-.5l-.9-2.1c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1.1 2.8 1.2 3c.1.2 2.1 3.2 5 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4Z" />
										<path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1 1 12 20.2Z" />
									</svg>
								)}
								{c.icon === 'github' && (
									<svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
										<path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.5 3.17-1.18 3.17-1.18.63 1.59.24 2.76.12 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.26 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z" />
									</svg>
								)}
								{c.icon === 'instagram' && (
									<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
										<rect width="18" height="18" x="3" y="3" rx="5" />
										<circle cx="12" cy="12" r="3.5" />
										<circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
									</svg>
								)}
							</span>

							<a href={c.href} target="_blank" rel="noopener noreferrer" class="min-w-0 flex-1">
								<span class="absolute inset-0" aria-hidden="true" />
								<span class="block font-mono text-[11px] uppercase tracking-wider text-faint">
									{c.label}
								</span>
								<span class="block truncate text-sm text-text">{c.value}</span>
							</a>

							{c.copy && (
								<button
									type="button"
									data-copy={c.copy}
									aria-label={ui.contact.copy}
									class="relative z-10 grid h-8 w-8 shrink-0 place-items-center rounded-lg border border-border text-faint transition-colors hover:border-accent hover:text-text"
								>
									<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<rect width="13" height="13" x="9" y="9" rx="2" />
										<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
									</svg>
								</button>
							)}
						</div>
					))
				}
			</div>

			<p class="mt-8 font-mono text-xs text-faint">
				<span class="text-accent">↳</span>
				{SITE.location[locale]}
			</p>
		</div>
	</div>
</section>

<div
	id="toast"
	role="status"
	aria-live="polite"
	class="pointer-events-none fixed bottom-6 left-1/2 z-[60] -translate-x-1/2 rounded-xl border border-border bg-card px-4 py-2.5 text-sm text-text opacity-0 shadow-xl transition-opacity duration-200"
>
</div>

<script>
	const toast = document.getElementById('toast');
	let timer: number | undefined;

	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
		btn.addEventListener('click', async (e) => {
			e.preventDefault();
			const value = btn.dataset.copy;
			if (!value || !toast) return;
			try {
				await navigator.clipboard.writeText(value);
				toast.textContent = document.documentElement.lang === 'es' ? '✓ Copiado' : '✓ Copied';
				toast.style.opacity = '1';
				clearTimeout(timer);
				timer = window.setTimeout(() => (toast.style.opacity = '0'), 1800);
			} catch {
				/* el portapapeles puede estar bloqueado; no rompemos la página */
			}
		});
	});
</script>
