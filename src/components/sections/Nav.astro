---
import { getLocale, t, localePath, type Locale } from '../../i18n/ui';
import { SITE } from '../../data/site';

const locale: Locale = getLocale(Astro.url);
const ui = t(locale);
const other: Locale = locale === 'es' ? 'en' : 'es';
const base = localePath(locale, '/');

const links = [
	{ href: `${base}#work`, label: ui.nav.work },
	{ href: `${base}#about`, label: ui.nav.about },
	{ href: `${base}#stack`, label: ui.nav.stack },
	{ href: `${base}#contact`, label: ui.nav.contact },
];
---

<header
	id="site-nav"
	class="fixed inset-x-0 top-0 z-50"
	data-scrolled="false"
>
	<div
		class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8"
	>
		<a
			href={base}
			class="group flex items-center gap-2 py-3 font-mono text-sm font-medium tracking-tight"
		>
			<span class="text-accent-ink">~/</span>
			<span class="text-text">{SITE.handle}</span>
		</a>

		<nav class="hidden items-center gap-1 md:flex" aria-label={ui.nav.primary}>
			{
				links.map((l) => (
					<a
						href={l.href}
						data-seccion={l.href.split('#')[1]}
						class="rounded-lg px-3 py-2 text-sm text-muted transition-colors duration-150 hover:bg-card hover:text-text aria-[current=true]:text-text aria-[current=true]:font-medium"
					>
						{l.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-1.5">
			<a
				id="lang-toggle"
				href={localePath(other, '/')}
				hreflang={other}
				aria-label={ui.lang.toggle}
				title={ui.lang.toggle}
				class="grid h-11 min-w-11 place-items-center rounded-lg border border-border px-2 font-mono text-xs font-medium text-muted transition-[border-color,color,scale] duration-150 ease-out hover:border-accent-ink hover:text-text motion-safe:active:scale-[0.97] sm:h-9 sm:min-w-9"
			>
				{other.toUpperCase()}
			</a>

			<button
				id="theme-toggle"
				type="button"
				aria-label={ui.theme.toggle}
				aria-pressed="false"
				title={ui.theme.toggle}
				class="grid h-11 w-11 place-items-center rounded-lg border border-border text-muted transition-[border-color,color,scale] duration-150 ease-out hover:border-accent-ink hover:text-text motion-safe:active:scale-[0.97] sm:h-9 sm:w-9"
			>
				<svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
				</svg>
				<svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
				</svg>
			</button>

			<button
				id="menu-toggle"
				type="button"
				aria-label={ui.nav.menu}
				aria-expanded="false"
				aria-controls="mobile-menu"
				class="grid h-11 w-11 place-items-center rounded-lg border border-border text-muted transition-[border-color,color,scale] duration-150 ease-out hover:border-accent-ink hover:text-text motion-safe:active:scale-[0.97] sm:h-9 sm:w-9 md:hidden"
			>
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<path d="M4 7h16M4 12h16M4 17h16"></path>
				</svg>
			</button>
		</div>
	</div>

	<div
		id="mobile-menu"
		hidden
		class="border-t border-border bg-card/95 px-5 py-3 backdrop-blur md:hidden"
	>
		<nav class="flex flex-col" aria-label={ui.nav.menu}>
			{
				links.map((l) => (
					<a
						href={l.href}
						class="rounded-lg px-3 py-3 text-sm text-muted transition-colors duration-150 hover:bg-bg-subtle hover:text-text"
					>
						{l.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<script>
	// Tema. Durante el cambio se apagan las transiciones (ver `.theme-switching`).
	const root = document.documentElement;
	const themeBtn = document.getElementById('theme-toggle');
	themeBtn?.setAttribute('aria-pressed', String(root.classList.contains('dark')));
	themeBtn?.addEventListener('click', () => {
		root.classList.add('theme-switching');
		const dark = root.classList.toggle('dark');
		themeBtn.setAttribute('aria-pressed', String(dark));
		try {
			localStorage.setItem('theme', dark ? 'dark' : 'light');
		} catch {}
		// Forzar el cálculo de estilos aplica el tema nuevo sin transiciones;
		// después ya se pueden volver a encender.
		void getComputedStyle(root).color;
		root.classList.remove('theme-switching');
	});

	// Cambiar de idioma conserva la sección en la que estabas.
	const langBtn = document.getElementById('lang-toggle') as HTMLAnchorElement | null;
	langBtn?.addEventListener('click', (e) => {
		if (!location.hash) return;
		e.preventDefault();
		location.href = langBtn.href.split('#')[0] + location.hash;
	});

	// Menú móvil
	const menuBtn = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');
	menuBtn?.addEventListener('click', () => {
		const open = menu?.hasAttribute('hidden');
		if (open) menu?.removeAttribute('hidden');
		else menu?.setAttribute('hidden', '');
		menuBtn.setAttribute('aria-expanded', String(open));
	});
	menu?.querySelectorAll('a').forEach((a) =>
		a.addEventListener('click', () => {
			menu.setAttribute('hidden', '');
			menuBtn?.setAttribute('aria-expanded', 'false');
		})
	);

	// Fondo del nav al hacer scroll (el estilo vive en global.css vía data-scrolled)
	const nav = document.getElementById('site-nav');
	let ticking = false;
	const onScroll = () => {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			if (nav) nav.dataset.scrolled = String(window.scrollY > 12);
			ticking = false;
		});
	};
	onScroll();
	window.addEventListener('scroll', onScroll, { passive: true });

	// Sección actual marcada en el nav
	const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-seccion]');
	if (navLinks.length && 'IntersectionObserver' in window) {
		const marcar = (id: string) =>
			navLinks.forEach((a) => a.setAttribute('aria-current', String(a.dataset.seccion === id)));
		const io = new IntersectionObserver(
			(entradas) => {
				for (const e of entradas) if (e.isIntersecting) marcar(e.target.id);
			},
			{ rootMargin: '-45% 0px -50% 0px' }
		);
		navLinks.forEach((a) => {
			const sec = a.dataset.seccion && document.getElementById(a.dataset.seccion);
			if (sec) io.observe(sec);
		});
	}
</script>
