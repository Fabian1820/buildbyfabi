---
import { getLocale, t, type Locale } from '../../i18n/ui';
import { SITE } from '../../data/site';

const locale: Locale = getLocale(Astro.url);
const ui = t(locale);
const year = new Date().getFullYear();

const enlaces = [
	{ label: 'GitHub', href: SITE.github },
	{ label: 'Instagram', href: SITE.instagram },
];
---

<footer class="border-t border-border">
	<div
		class="mx-auto flex max-w-6xl flex-col gap-4 px-5 py-10 sm:flex-row sm:items-center sm:justify-between sm:px-8"
	>
		<div class="flex flex-col gap-1">
			<span class="font-mono text-sm text-text">{SITE.domain}</span>
			<span class="text-xs text-faint">© {year} {SITE.name}</span>
		</div>

		<div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-muted">
			{
				enlaces.map((e) => (
					<a
						href={e.href}
						target="_blank"
						rel="noopener noreferrer"
						class="py-2 underline decoration-transparent underline-offset-4 transition-colors duration-150 hover:text-text hover:decoration-border-strong"
					>
						{e.label}
					</a>
				))
			}
			<span class="text-xs text-faint">{ui.footer.built} Astro + Tailwind</span>
		</div>
	</div>
</footer>
