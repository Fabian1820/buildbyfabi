---
import '../styles/global.css';
import { SITE } from '../data/site';
import { getLocale, t, localePath, type Locale } from '../i18n/ui';
import Nav from '../components/sections/Nav.astro';
import Footer from '../components/sections/Footer.astro';

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
}

const locale: Locale = getLocale(Astro.url);
const ui = t(locale);
const { title, description, noindex = false } = Astro.props;

const pageTitle = title ?? `${SITE.shortName} — ${ui.hero.role}`;
const pageDesc = description ?? ui.hero.tagline;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(locale === 'en' ? '/og-en.png' : '/og.png', SITE.url).href;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: SITE.name,
	alternateName: SITE.handle,
	url: SITE.url,
	image: new URL('/images/perfil.jpg', SITE.url).href,
	email: `mailto:${SITE.email}`,
	jobTitle: locale === 'es' ? 'Desarrollador de Software Full-Stack' : 'Full-Stack Software Developer',
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Havana',
		addressCountry: 'CU',
	},
	alumniOf: {
		'@type': 'CollegeOrUniversity',
		name: 'Universidad Tecnológica de La Habana José Antonio Echeverría (CUJAE)',
	},
	knowsAbout: ['React', 'Next.js', 'TypeScript', 'Python', 'FastAPI', 'MongoDB', 'Astro'],
	sameAs: [SITE.github, SITE.instagram],
};
---

<!doctype html>
<html lang={locale} class="scroll-pt-24">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{pageTitle}</title>
		<meta name="description" content={pageDesc} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<link rel="alternate" hreflang="es" href={new URL(localePath('es', '/'), SITE.url).href} />
		<link rel="alternate" hreflang="en" href={new URL(localePath('en', '/'), SITE.url).href} />
		<link rel="alternate" hreflang="x-default" href={SITE.url} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE.domain} />
		<meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDesc} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${SITE.name} — ${ui.hero.role}`} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDesc} />
		<meta name="twitter:image" content={ogImage} />

		{/* Lo pinta el script de abajo según el tema que salga; sin JS queda claro. */}
		<meta name="theme-color" content="#f7f5f1" id="tema-color" />

		<script is:inline set:html={JSON.stringify(jsonLd)} type="application/ld+json" />

		{/* Evita el flash de tema incorrecto: corre antes del primer paint */}
		<script is:inline>
			(() => {
				// Sin preferencia guardada, el tema lo decide el sol sobre La Habana:
				// de día claro, de noche oscuro. Copia mínima de altitudSolar() de
				// src/lib/sol.ts — si cambia la fórmula allí, cambia también aquí.
				const solArriba = () => {
					const ahora = new Date();
					const dia = Math.floor((ahora - Date.UTC(ahora.getUTCFullYear(), 0, 1)) / 86400000);
					const hora = ahora.getUTCHours() + ahora.getUTCMinutes() / 60;
					const g = ((2 * Math.PI) / 365) * (dia + (hora - 12) / 24);
					const ecuacion =
						229.18 *
						(0.000075 +
							0.001868 * Math.cos(g) -
							0.032077 * Math.sin(g) -
							0.014615 * Math.cos(2 * g) -
							0.040849 * Math.sin(2 * g));
					const declinacion =
						0.006918 -
						0.399912 * Math.cos(g) +
						0.070257 * Math.sin(g) -
						0.006758 * Math.cos(2 * g) +
						0.000907 * Math.sin(2 * g) -
						0.002697 * Math.cos(3 * g) +
						0.00148 * Math.sin(3 * g);
					const angulo = (((hora * 60 + ecuacion + 4 * -82.3666) / 4 - 180) * Math.PI) / 180;
					const lat = (23.1136 * Math.PI) / 180;
					const cosCenit =
						Math.sin(lat) * Math.sin(declinacion) +
						Math.cos(lat) * Math.cos(declinacion) * Math.cos(angulo);
					return 90 - (Math.acos(Math.min(1, Math.max(-1, cosCenit))) * 180) / Math.PI > -0.833;
				};

				const stored = localStorage.getItem('theme');
				let dark;
				try {
					dark = stored ? stored === 'dark' : !solArriba();
				} catch {
					dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
				}
				document.documentElement.classList.toggle('dark', dark);
				document
					.getElementById('tema-color')
					?.setAttribute('content', dark ? '#0a0d14' : '#f7f5f1');

				// Marca el documento antes de pintar para que lo revelable nazca
				// oculto; quien pidió menos movimiento ve la página tal cual.
				const quietud = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				if (!quietud && 'IntersectionObserver' in window) {
					document.documentElement.classList.add('js-reveal');
				}
			})();
		</script>
	</head>

	<body class="min-h-screen bg-bg text-text">
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-white"
		>
			{locale === 'es' ? 'Saltar al contenido' : 'Skip to content'}
		</a>

		<Nav />
		<main id="main">
			<slot />
		</main>
		<Footer />

		<script>
			// Cada bloque marcado aparece al entrar en pantalla, una sola vez.
			const revelables = document.querySelectorAll<HTMLElement>('[data-reveal]');

			if (document.documentElement.classList.contains('js-reveal') && revelables.length) {
				const observador = new IntersectionObserver(
					(entradas) => {
						for (const entrada of entradas) {
							if (!entrada.isIntersecting) continue;
							entrada.target.classList.add('revelado');
							observador.unobserve(entrada.target);
						}
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
				);

				revelables.forEach((el) => observador.observe(el));
			} else {
				revelables.forEach((el) => el.classList.add('revelado'));
			}
		</script>

		<script is:inline>
			console.log(
				`%c
   ┌────────────────────────────────┐
   │   buildbyfabi.dev              │
   │   Fabián Fernández Gálvez      │
   └────────────────────────────────┘

   Curioso, ¿eh? Me gusta eso.
   Si llegaste hasta aquí, probablemente
   deberíamos trabajar juntos.

   → fernandezfabian2003@gmail.com
`,
				'color:#8b5cf6;font-family:monospace;font-size:12px;line-height:1.5'
			);
		</script>
	</body>
</html>
